local hiddenStatsEnabled = false
local originalValues = {}
local privacyPaths = {"HideKillerWins", "HidePlaytime", "HideSurvivorWins"}
local function saveOriginals(p)
    originalValues[p.UserId] = originalValues[p.UserId] or {}
    local pd = p:FindFirstChild("PlayerData")
    local priv = pd and pd:FindFirstChild("Settings") and pd.Settings:FindFirstChild("Privacy")
    if not priv then return end
    for _, k in ipairs(privacyPaths) do local v = priv:FindFirstChild(k) if v then originalValues[p.UserId][k] = v.Value end end
end
local function reveal(p)
    local pd = p:FindFirstChild("PlayerData")
    local priv = pd and pd:FindFirstChild("Settings") and pd.Settings:FindFirstChild("Privacy")
    if not priv then return end
    for _, k in ipairs(privacyPaths) do local v = priv:FindFirstChild(k) if v then v.Value = false end end
end
local function restore(p)
    if not originalValues[p.UserId] then return end
    local pd = p:FindFirstChild("PlayerData")
    local priv = pd and pd:FindFirstChild("Settings") and pd.Settings:FindFirstChild("Privacy")
    if not priv then return end
    for k, val in pairs(originalValues[p.UserId]) do local v = priv:FindFirstChild(k) if v then v.Value = val end end
end
