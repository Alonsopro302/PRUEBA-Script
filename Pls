local function GetAnimationType(ID)
    if not ID then return nil end
    local idNum = tostring(ID):match("%d+") or tostring(ID)
    for name, anims in pairs(AllAnimations) do
        for animType, animId in pairs(anims) do
            if type(animId) == "table" then
                for _, v in pairs(animId) do
                    if type(v) == "string" and v:find(tostring(idNum)) then return animType, name end
                end
            else
                if type(animId) == "string" and animId:find(tostring(idNum)) then return animType, name end
            end
        end
    end
    return nil
end

